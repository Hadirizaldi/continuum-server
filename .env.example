# Application
APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=

# Upload
UPLOAD_MAX_FILE_SIZE=2147483648
UPLOAD_CHUNK_SIZE=5242880
UPLOAD_ALLOWED_MIME_TYPES=video/*,image/*,audio/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.*,application/zip,application/x-rar-compressed,application/vnd.rar
UPLOAD_SESSION_TTL=24h
UPLOAD_USER_ID_HEADER=X-User-ID

# Storage
STORAGE_TYPE=local
STORAGE_FINAL_PATH_PATTERN={category}/{session_id}/{filename}
STORAGE_PUBLIC_URL_PREFIX=/files
STORAGE_LOCAL_BASE_PATH=/var/storage

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=uploads
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=25
